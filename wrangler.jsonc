{
  "name": "untitled",
  "main": "Alex/index.ts",
  "compatibility_date": "2026-08-23",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alex-ecosystem",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "Alex/database/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "alex-ecosystem-r2-placeholder"
    }
  ],
  "queues": {
    "producers": [
      {
        "queue": "alex-ecosystem-jobs",
        "binding": "JOBS"
      }
    ]
  }
}
